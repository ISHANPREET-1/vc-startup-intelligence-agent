    {
      "parameters": {
        "jsCode": "const startups = $json.startups\n  .map(item => item.output)\n  .filter(startup =>\n    startup &&\n    startup.startup_name &&\n    startup.startup_name !== \"Unknown\"\n  );\n\nconst uniqueStartups = [\n  ...new Map(\n    startups.map(s => [s.startup_name, s])\n  ).values()\n];\n\nreturn [\n  {\n    json: {\n      startups: uniqueStartups\n    }\n  }\n];"
      },
